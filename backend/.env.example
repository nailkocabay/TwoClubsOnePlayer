# Path to the Transfermarkt DuckDB file (opened READ-ONLY, never modified)
DUCKDB_PATH=../data/transfermarkt-datasets.duckdb
# Comma-separated list of allowed browser origins (local development defaults)
# For production (e.g. Render), set this to your Cloudflare Pages domain or '*'
# Example: CORS_ORIGINS=https://twoclubsoneplayer.pages.dev,http://localhost:3000 or CORS_ORIGINS=*
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Player photos are hotlinks to Transfermarkt's CDN. Their reuse terms are not
# granted by this dataset, so they are OFF by default. Enable only if you have permission.
ENABLE_PLAYER_IMAGES=false
